{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "licensing-route": {
        "ClusterId": "licensing-cluster",
        "Match": { "Path": "/api/licenses/{**catch-all}" }
      },
      "apps-route": {
        "ClusterId": "licensing-cluster",
        "Match": { "Path": "/api/apps/{**catch-all}" }
      },
      "jobs-route": {
        "ClusterId": "licensing-cluster",
        "Match": { "Path": "/api/jobs/{**catch-all}" }
      },
      "metering-route": {
        "ClusterId": "metering-cluster",
        "Match": { "Path": "/api/metering/{**catch-all}" }
      }
    },
    "Clusters": {
      "licensing-cluster": {
        "Destinations": {
          "licensing-service": {
            "Address": "http://licensing-service:8081"
          }
        }
      },
      "metering-cluster": {
        "Destinations": {
          "metering-service": {
            "Address": "http://metering-service:8082"
          }
        }
      }
    }
  }
}
